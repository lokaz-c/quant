# Copy to .env and fill in. Never commit .env.

# Web app
DATABASE_URL=postgresql://quant_user:quant_pass@localhost:5432/quant_db
SECRET_KEY=change-me

# Data source (docs/market-data.md). Without MARKET_DATA_URL, backtests use the
# seeded synthetic file data/sample_data.csv. With it, they use the market-data
# service by default; QUANT_DATA_SOURCE=synthetic keeps the file as the default.
# `make results` always uses the synthetic file.
QUANT_DATA_SOURCE=
MARKET_DATA_URL=
# Sent as X-API-Key. Without a key the service shows only its public sources,
# which are synthetic unless its operator has Alpaca's written consent.
MARKET_DATA_API_KEY=
# split (default) or raw
MARKET_DATA_ADJUSTMENT=
# Default data/cache (git-ignored); "off" disables the cache
MARKET_DATA_CACHE_DIR=
# Read timeout in seconds (default 30)
MARKET_DATA_TIMEOUT=

# Alpaca paper trading (live_trading/). Paper keys come from the paper dashboard
# at https://app.alpaca.markets and differ from live keys.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Live (real-money) trading stays off unless this is exactly "yes" AND the code
# passes paper=False to AlpacaBroker. Leave it empty.
QUANT_ALLOW_LIVE_TRADING=
