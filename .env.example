# Copy to .env and fill in. Never commit .env.

# Web app
DATABASE_URL=postgresql://quant_user:quant_pass@localhost:5432/quant_db
SECRET_KEY=change-me

# Alpaca paper trading (live_trading/). Paper keys come from the paper dashboard
# at https://app.alpaca.markets and differ from live keys.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Live (real-money) trading stays off unless this is exactly "yes" AND the code
# passes paper=False to AlpacaBroker. Leave it empty.
QUANT_ALLOW_LIVE_TRADING=
