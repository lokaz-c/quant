# Copy to .env and fill in. Never commit .env.

# Web app
DATABASE_URL=postgresql://quant_user:quant_pass@localhost:5432/quant_db
SECRET_KEY=change-me

# Data source (docs/market-data.md). Without MARKET_DATA_URL, backtests use the
# seeded synthetic file data/sample_data.csv. With it, they use the market-data
# service by default; QUANT_DATA_SOURCE=synthetic keeps the file as the default.
# `make results` always uses the synthetic file.
QUANT_DATA_SOURCE=
MARKET_DATA_URL=
# Sent as X-API-Key. Without a key the service shows only its public sources,
# which are synthetic unless its operator has Alpaca's written consent.
MARKET_DATA_API_KEY=
# split (default) or raw
MARKET_DATA_ADJUSTMENT=
# Default data/cache (git-ignored); "off" disables the cache
MARKET_DATA_CACHE_DIR=
# Read timeout in seconds (default 30)
MARKET_DATA_TIMEOUT=

# Public deployment (app/config.py, README "Deploying"). All optional; the
# defaults are shown. Bad values stop the app at startup.
# Origins allowed to call /api from a browser, comma-separated. Empty: no CORS
# headers (the bundled frontend is same-origin and needs none).
QUANT_CORS_ORIGINS=
# SHA-256 hex digest(s) of API keys, comma-separated. A request with a valid
# X-API-Key is not rate limited; a wrong key is a 401. Make a key and its digest:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#   printf %s "$KEY" | shasum -a 256
QUANT_API_KEY_SHA256=
# Header the proxy sets to the client address. Only set it behind a proxy that
# overwrites it (Render: CF-Connecting-IP); otherwise clients can spoof it.
QUANT_CLIENT_IP_HEADER=
# Per client address. Runs: POST /api/backtest/, /api/backtest/regime-analysis
# and /api/strategies/, one shared limit. Reads: every other /api request.
QUANT_RATE_LIMIT_RUNS="5 per minute;30 per hour"
QUANT_RATE_LIMIT_READS="120 per minute"
# off disables rate limiting
QUANT_RATE_LIMITS=on
# memory:// is per process; redis://host:6379 shares counters across processes
QUANT_RATE_LIMIT_STORAGE_URI=memory://
# Request caps and the per-request time limit (both runs of a baseline pair)
QUANT_MAX_SYMBOLS=10
QUANT_MAX_RANGE_DAYS=1827
QUANT_BACKTEST_TIMEOUT_SECONDS=90
# Backtests running at once in the process; more get a 503 with Retry-After
QUANT_MAX_CONCURRENT_RUNS=1

# Alpaca paper trading (live_trading/). Paper keys come from the paper dashboard
# at https://app.alpaca.markets and differ from live keys.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Live (real-money) trading stays off unless this is exactly "yes" AND the code
# passes paper=False to AlpacaBroker. Leave it empty.
QUANT_ALLOW_LIVE_TRADING=
